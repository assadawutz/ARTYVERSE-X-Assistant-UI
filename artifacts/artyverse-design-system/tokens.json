{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "ARTYVERSE X Assistant tokens extracted from the product UI. Light values follow the supplied interface; dark values are derived because the source app has no dark theme. Edit this file only; generated theme files are rebuilt by scripts/build-tokens.mjs.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f7f9fc" },
      "foreground": { "$value": "#1d2749" },
      "border": { "$value": "#e5eaf2" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#24304f" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#24304f" },
      "primary": {
        "$value": "#d90e73",
        "$description": "Accessible deep pink for primary actions; the vivid pink is reserved for decorative accents."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#f3f7ff" },
      "secondaryForeground": { "$value": "#24304f" },
      "muted": { "$value": "#f4f7fc" },
      "mutedForeground": { "$value": "#56617b" },
      "accent": { "$value": "#c4ef22" },
      "accentForeground": { "$value": "#243000" },
      "destructive": { "$value": "#a52436" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#e3e8f0" },
      "ring": { "$value": "#d90e73" },
      "chart1": { "$value": "#d90e73" },
      "chart2": { "$value": "#a9e51d" },
      "chart3": { "$value": "#25304d" },
      "chart4": { "$value": "#169f99" },
      "chart5": { "$value": "#7764d8" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#24304f" },
      "sidebarBorder": { "$value": "#e5eaf2" },
      "sidebarPrimary": { "$value": "#d90e73" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#fff1f8" },
      "sidebarAccentForeground": { "$value": "#24304f" },
      "sidebarRing": { "$value": "#d90e73" }
    },
    "dark": {
      "background": { "$value": "#151625" },
      "foreground": { "$value": "#f5f7fc" },
      "border": { "$value": "#34374b" },
      "card": { "$value": "#202237" },
      "cardForeground": { "$value": "#f5f7fc" },
      "popover": { "$value": "#202237" },
      "popoverForeground": { "$value": "#f5f7fc" },
      "primary": { "$value": "#ff4ea5" },
      "primaryForeground": { "$value": "#25131f" },
      "secondary": { "$value": "#292c41" },
      "secondaryForeground": { "$value": "#f1f3fb" },
      "muted": { "$value": "#292c41" },
      "mutedForeground": { "$value": "#b0b5c8" },
      "accent": { "$value": "#c8f126" },
      "accentForeground": { "$value": "#242b0a" },
      "destructive": { "$value": "#ff6878" },
      "destructiveForeground": { "$value": "#29171c" },
      "input": { "$value": "#3b3e53" },
      "ring": { "$value": "#ff4ea5" },
      "chart1": { "$value": "#ff4ea5" },
      "chart2": { "$value": "#c8f126" },
      "chart3": { "$value": "#8ca8ff" },
      "chart4": { "$value": "#43d4c9" },
      "chart5": { "$value": "#c2a3ff" },
      "sidebar": { "$value": "#191b2d" },
      "sidebarForeground": { "$value": "#f5f7fc" },
      "sidebarBorder": { "$value": "#34374b" },
      "sidebarPrimary": { "$value": "#ff4ea5" },
      "sidebarPrimaryForeground": { "$value": "#25131f" },
      "sidebarAccent": { "$value": "#292c41" },
      "sidebarAccentForeground": { "$value": "#f5f7fc" },
      "sidebarRing": { "$value": "#ff4ea5" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["IBM Plex Sans Thai", "Space Grotesk", "sans-serif"],
        "$description": "Thai-first UI and body typeface, with Space Grotesk for Latin labels."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Space Grotesk", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.85rem",
      "$description": "Soft 14px base radius drawn from the app's cards and controls."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Four-pixel base rhythm for compact, responsive controls."
    }
  }
}
